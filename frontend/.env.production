# Copy this file to .env.production and fill in your values
# These are placeholder values - replace with real API keys

# Claude API (required for chat functionality)
# Get your key from: https://api.codemax.pro/
CLAUDE_API_KEY=your_claude_api_key_here

# HuggingFace API (optional - for alternative model inference)
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_token_here
HUGGINGFACE_MODEL_ID=gpt2
